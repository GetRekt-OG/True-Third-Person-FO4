    {
      "pageDisplayName": "Camera Offsets",
      "content": [
        {
          "text": "Added to the game's camera position (fOverShoulder* settings), so they work together with other camera mods: your +40 and another mod's -40 give 0. Applies when you close the pause menu.",
          "type": "text"
        },
        {
          "text": "Weapon holstered",
          "type": "section"
        },
        {
          "id": "fHolsteredX:CameraOffset",
          "type": "slider",
          "text": "Side",
          "help": "Moves the camera right (positive) or left (negative), added on top of the game's own setting or another camera mod's.",
          "valueOptions": {
            "sourceType": "ModSettingFloat",
            "min": -100,
            "max": 100,
            "step": 1
          }
        },
        {
          "id": "fHolsteredZ:CameraOffset",
          "type": "slider",
          "text": "Height",
          "help": "Moves the camera up (positive) or down (negative), added on top of the game's own setting or another camera mod's.",
